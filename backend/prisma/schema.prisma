// =============================================================================
// HRMS — Personal & Education Module ONLY
// Sections: Employee Info, General Info, Personal Info, Local Address,
//           Permanent Address, Other Info, Family Info, Academic Qualifications
// PostgreSQL + Prisma ORM
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // native = local Windows/Mac; debian = Render; musl = Alpine Docker
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum EmployeeCategory {
  TEACHING
  NON_TEACHING
  CONTRACT
  VISITING
}

enum AppointmentType {
  FULL_TIME_REGULAR
  FULL_TIME_CONTRACT
  PART_TIME
  VISITING
  DEPUTATION
}

enum FamilyRelation {
  FATHER
  MOTHER
  SPOUSE
  SON
  DAUGHTER
  BROTHER
  SISTER
  GUARDIAN
  OTHER
}

enum DegreeType {
  SSC // Standard 10  — compulsory
  HSC // Standard 12  — compulsory OR Diploma
  DIPLOMA // Diploma       — compulsory OR HSC
  BACHELOR // UG degree     — compulsory
  MASTER // PG degree     — compulsory
  PHD // Doctorate     — optional
  OTHER // Other qualifications
}

enum AcademicMedium {
  GUJARATI
  HINDI
  ENGLISH
  MARATHI
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
  RETIRED
  TERMINATED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveApplicableTo {
  TEACHING
  NON_TEACHING
  BOTH
}

enum LeaveApplicationStatus {
  PENDING
  HOD_RECOMMENDED
  HOI_RECOMMENDED
  APPROVED
  REJECTED
  CANCELLED
  AUTO_LWP
}

enum HalfDaySession {
  MORNING
  AFTERNOON
}

enum ApproverRole {
  HOD
  HOI
  VC
  REGISTRAR
  FIRST_REPORTING
  SECOND_REPORTING
  THIRD_REPORTING
}

enum ApprovalAction {
  RECOMMENDED
  REJECTED
  APPROVED
}

enum RuleType {
  FIXED
  PERCENTAGE
  CONDITIONAL
}

enum ConditionComparator {
  GREATER_THAN
  LESS_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN_OR_EQUAL
  EQUAL
}

enum ConditionResultType {
  FIXED_AMOUNT
  PERCENTAGE_OF_COLUMN
}

enum SalaryColumnCategory {
  EARNING
  DEDUCTION
}

enum SalaryRecordStatus {
  UNPAID
  PAID
}

// =============================================================================
// 1. EMPLOYEE INFO
// Core identity row — every other section FKs here
// Auto-increment int ID matching college's existing numbering (29, 30, ...)
// =============================================================================

model Employee {
  id           Int            @id @default(autoincrement()) // Card ID: 29
  abbreviation String?        @db.VarChar(10) // DSP
  userId       String         @unique @map("user_id") // FK → auth user table
  status       EmployeeStatus @default(ACTIVE)

  // Photo & signature — Cloudinary URLs
  photoUrl     String? @map("photo_url")
  signatureUrl String? @map("signature_url")

  lastUpdatedAt DateTime @updatedAt @map("last_updated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  // Relations — only the 8 sections you specified
  generalInfo    EmployeeGeneralInfo?
  personalInfo   EmployeePersonalInfo?
  addresses      EmployeeAddress[]
  otherInfo      EmployeeOtherInfo?
  familyMembers  FamilyMember[]
  academicQuals  AcademicQualification[]
  experiences    EmployeeExperience[]
  salaryInfo     EmployeeSalaryInfo?
  bankInfo       EmployeeBankInfo?
  user           User?
  changeRequests ChangeRequest[]

  leaveBalances      LeaveBalance[]
  leaveApplications  LeaveApplication[]
  leaveAuditLogs     LeaveAuditLog[]
  monthlyLwpRecords  MonthlyLWPRecord[]
  absences           AbsenceRecord[]
  attendancePunches  AttendancePunch[]
  attendanceSettings EmployeeAttendanceSettings?

  letterDocuments     EmployeeLetterDocument[]
  reimbursements      ReimbursementClaim[]
  hiredFromCandidates RecruitmentCandidate[]   @relation("HiredEmployee")

  hodDepartments          DepartmentApprover[] @relation("DepartmentHod")
  hoiInstitutes           InstituteApprover[]  @relation("InstituteHoi")
  vcGlobalApprover        GlobalApprover[]     @relation("GlobalApproverVC")
  registrarGlobalApprover GlobalApprover[]     @relation("GlobalApproverRegistrar")

  firstReportingFor  EmployeeGeneralInfo[] @relation("FirstReporting")
  secondReportingFor EmployeeGeneralInfo[] @relation("SecondReporting")
  thirdReportingFor  EmployeeGeneralInfo[] @relation("ThirdReporting")

  assignments         EmployeeAssignment[]
  salaryRecords       EmployeeSalaryRecord[]
  positionAssignments PositionAssignment[]
  locationHistories   LocationHistory[]
  trips               Trip[]
  trackingEvents      TrackingEvent[]
  workTasks           WorkTask[]
  orgTreeContacts     OrgTreeContact[]
  ownedErpProjects    ErpProject[]

  @@map("employees")
}

// =============================================================================
// 2. GENERAL INFORMATION
// PDF fields: Full Name, Original Joining Date, Joining Date, Increment Month,
//             Organization, Sub Organization, Department, Functional Department,
//             First Reporting, Second Reporting, Employee Category,
//             Designation, Shift, Appointment Type
// =============================================================================

model EmployeeGeneralInfo {
  id         String @id @default(uuid())
  employeeId Int    @unique @map("employee_id")

  fullName String @map("full_name") // DINESH SHANKARBHAI PATEL

  // Joining
  originalJoiningDate DateTime @map("original_joining_date") // 11/06/2014
  joiningDate         DateTime @map("joining_date") // 11/06/2014
  incrementMonth      String?  @map("increment_month") // July

  // Organization
  organization    String // GANDHINAGAR UNIVERSITY
  instituteId     String?    @map("institute_id")
  institute       Institute? @relation(fields: [instituteId], references: [id])
  subOrganization String?    @map("sub_organization") // institute code (e.g. GIT), synced from institute

  // Department
  department           String // ADMIN DEPARTMENT
  functionalDepartment String? @map("functional_department") // ADMIN DEPARTMENT

  // Reporting hierarchy (FK to Employee.id)
  firstReportingId  Int? @map("first_reporting_id")
  secondReportingId Int? @map("second_reporting_id")
  thirdReportingId  Int? @map("third_reporting_id")

  firstReportingEmployee  Employee? @relation("FirstReporting", fields: [firstReportingId], references: [id])
  secondReportingEmployee Employee? @relation("SecondReporting", fields: [secondReportingId], references: [id])
  thirdReportingEmployee  Employee? @relation("ThirdReporting", fields: [thirdReportingId], references: [id])

  // Approver slots (polymorphic: can point to employee-users or position-users)
  // Preferred for leave workflow; NULL bypasses that layer.
  firstApproverUserId  String? @map("first_approver_user_id")
  secondApproverUserId String? @map("second_approver_user_id")
  thirdApproverUserId  String? @map("third_approver_user_id")

  firstApproverUser  User? @relation("FirstApproverUser", fields: [firstApproverUserId], references: [id])
  secondApproverUser User? @relation("SecondApproverUser", fields: [secondApproverUserId], references: [id])
  thirdApproverUser  User? @relation("ThirdApproverUser", fields: [thirdApproverUserId], references: [id])

  // Employment classification
  employeeCategory String       @map("employee_category") // NON_TEACHING (lookup)
  designation      String // O.S. ESTABLISHMENT (legacy, synced from designationRef)
  designationId    String?      @map("designation_id")
  designationRef   Designation? @relation(fields: [designationId], references: [id])
  shift            String? // GENERAL (lookup)
  appointmentType  String?      @map("appointment_type") // FULL_TIME_REGULAR (lookup)
  employeeCode     String?      @unique @map("employee_code") // GU1234
  /// Biometric / attendance machine punch ID (maps to eTimeOffice Empcode). Not the HRMS employee code.
  punchId          String?      @unique @map("punch_id")
  /// Weekly off / employee-specific holiday days, e.g. ["SUN"] or ["SAT","SUN"].
  weeklyOffDays    String[]     @default(["SUN"]) @map("weekly_off_days")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_general_info")
}

// =============================================================================
// EMPLOYMENT ASSIGNMENTS (effective-dated institute/designation history)
// =============================================================================

model EmployeeAssignment {
  id         String @id @default(uuid())
  employeeId Int    @map("employee_id")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  organization    String? // optional snapshot; current system uses a single org mostly
  instituteId     String?      @map("institute_id")
  institute       Institute?   @relation(fields: [instituteId], references: [id])
  subOrganization String?      @map("sub_organization")
  department      String?
  designation     String
  designationId   String?      @map("designation_id")
  designationRef  Designation? @relation(fields: [designationId], references: [id])
  shift           String?
  appointmentType String?      @map("appointment_type")

  reason     String?
  changeType String?  @map("change_type") // INSTITUTE_TRANSFER | DESIGNATION_UPGRADE | JOINING
  changedBy  String   @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveApplications LeaveApplication[]
  absenceRecords    AbsenceRecord[]
  salaryRecords     EmployeeSalaryRecord[]

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, effectiveTo])
  @@map("employee_assignments")
}

// =============================================================================
// 3. PERSONAL INFORMATION
// PDF fields: Birth Date, Birth Place, Home Town, Gender, Marital Status,
//             Nationality, Mother Tongue, Blood Group, Cast Category, Sub Caste,
//             Nominee Name, Nominee Relation
// Added (as requested): Aadhaar No (encrypted), PAN No (encrypted),
//                       Aadhaar card upload, PAN card upload
// Passport fields also in PDF's personal block — included here
// =============================================================================

model EmployeePersonalInfo {
  id         String @id @default(uuid())
  employeeId Int    @unique @map("employee_id")

  // PDF — Personal Information section
  birthDate     DateTime @map("birth_date") // 27/05/1974
  birthPlace    String?  @map("birth_place") // RUPAL
  homeTown      String?  @map("home_town") // RUPAL
  gender        String // MALE (lookup)
  maritalStatus String   @map("marital_status") // MARRIED (lookup)
  nationality   String   @default("INDIAN") // lookup
  motherTongue  String?  @map("mother_tongue") // GUJARATI (lookup)
  bloodGroup    String?  @map("blood_group") // A_POS (lookup)

  // Caste — Indian govt. requirement
  castCategory String? @map("cast_category") // OPEN
  subCaste     String? @map("sub_caste") // KADVA PATEL

  // Nominee — kept in personal info as shown in PDF
  nomineeName     String? @map("nominee_name") // KAILASH
  nomineeRelation String? @map("nominee_relation") // WIFE

  // Identity numbers — ENCRYPTED at rest via Express/AES-256, never via Hasura
  aadhaarNo String? @map("aadhaar_no") // encrypted
  panNo     String? @map("pan_no") // encrypted

  // Identity document scans — Cloudinary
  aadhaarCardUrl   String? @map("aadhaar_card_url")
  panCardUrl       String? @map("pan_card_url")
  otherDocumentUrl String? @map("other_document_url")

  // Passport — from PDF
  passportNo         String?   @map("passport_no")
  passportIssuePlace String?   @map("passport_issue_place")
  passportIssueDate  DateTime? @map("passport_issue_date")
  passportExpiryDate DateTime? @map("passport_expiry_date")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_personal_info")
}

// =============================================================================
// 4 & 5. LOCAL ADDRESS + PERMANENT ADDRESS
// PDF fields: Flat/Block No, Building/Society, Area, City, State, Country,
//             Zip/Postal Code, Phone No, Mobile No
// Local address also has: Intercom No, Personal Email, Institute Email, URL
// Single model with AddressType discriminator — avoids duplicating 12 columns
// @@unique([employeeId, addressType]) → exactly one LOCAL + one PERMANENT per employee
// =============================================================================

enum AddressType {
  LOCAL
  PERMANENT
}

model EmployeeAddress {
  id          String      @id @default(uuid())
  employeeId  Int         @map("employee_id")
  addressType AddressType @map("address_type")

  // Both address types
  flatBlockNo     String? @map("flat_block_no") // 407 / 279
  buildingSociety String? @map("building_society") // DEVBHUMI PLAZA / TIMBAVAS
  area            String? // OPP. SANKALP... / MOTO MADH
  city            String? // BORISNA / RUPAL
  state           String? // GUJARAT
  country         String? @default("INDIA")
  zipPostalCode   String? @map("zip_postal_code") // 382721
  phoneNo         String? @map("phone_no")
  mobileNo        String? @map("mobile_no") // 9904405950

  // Local address only — present in PDF's local address block
  intercomNo     String? @map("intercom_no") // 203
  personalEmail  String? @map("personal_email") // dspatel2011@gmail.com
  instituteEmail String? @map("institute_email") // dinesh.patel@gandhinagaruni.ac.in
  /// Set when employee verifies this address via OTP after first password change
  personalEmailVerifiedAt  DateTime? @map("personal_email_verified_at")
  instituteEmailVerifiedAt DateTime? @map("institute_email_verified_at")
  url            String? // personal website

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, addressType])
  @@map("employee_addresses")
}

// =============================================================================
// 6. OTHER INFORMATION
// PDF fields: Skill Set, Hobbies, Strength, Weakness,
//             Is Handicapped, Height (In Feet), Weight (In Kg)
// Note: Aadhaar, PAN, Passport appear in PDF's Other Info block but are
//       semantically identity data — moved to Personal Info above
// =============================================================================

model EmployeeOtherInfo {
  id         String @id @default(uuid())
  employeeId Int    @unique @map("employee_id")

  skillSet        String? @map("skill_set") // HR
  hobbies         String? // MUSIC
  strength        String? // FAMILY
  weakness        String? // FAMILY
  isHandicapped   Boolean @default(false) @map("is_handicapped") // No
  handicapDetails String? @map("handicap_details")

  passportUrl String? @map("passport_url")

  // Physical — from PDF
  heightInFeet Decimal? @map("height_in_feet") @db.Decimal(5, 2) // 157.00
  weightInKg   Decimal? @map("weight_in_kg") @db.Decimal(5, 2) // 79

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_other_info")
}

// =============================================================================
// 7. FAMILY INFORMATION
// PDF fields: Relation, Name, City, Mobile No, Personal Email
// Added (as requested): Date of Birth, Aadhaar No (encrypted), Nominee flag
// =============================================================================

model FamilyMember {
  id         String @id @default(uuid())
  employeeId Int    @map("employee_id")

  // PDF fields
  relation      String // FATHER (lookup)
  name          String
  city          String?
  mobileNo      String? @map("mobile_no") // 9998414432
  personalEmail String? @map("personal_email")

  // Extended (as requested)
  dateOfBirth  DateTime? @map("date_of_birth")
  aadhaarNo    String?   @map("aadhaar_no") // encrypted AES-256
  aadhaarUrl   String?   @map("aadhaar_url") // Cloudinary scan
  isNominee    Boolean   @default(false) @map("is_nominee")
  isDependent  Boolean   @default(false) @map("is_dependent")
  isEmployed   Boolean   @default(false) @map("is_employed")
  employerName String?   @map("employer_name")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("family_members")
}

// =============================================================================
// 8. ACADEMIC QUALIFICATIONS
// PDF fields: Degree Type, Medium, Board/University, School/College,
//             Passing Year, Percentage/Grade, Specialization
// Added: Certificate upload, Sem-wise marksheets (sem1–sem8), Verification
//
// Compulsory rules enforced at APPLICATION layer (not DB — keeps it flexible):
//   SSC      → always compulsory
//   HSC      → compulsory unless DIPLOMA exists
//   DIPLOMA  → compulsory unless HSC exists
//   BACHELOR → always compulsory
//   MASTER   → always compulsory
//   PHD      → optional
//
// @@unique([employeeId, degreeType]) — one record per degree type per employee
// =============================================================================

model AcademicQualification {
  id         String @id @default(uuid())
  employeeId Int    @map("employee_id")

  // PDF fields
  degreeType      String   @map("degree_type") // SSC (lookup)
  degreeName      String?  @map("degree_name") // B.E. Computer Engineering
  medium          String? // ENGLISH (lookup)
  boardUniversity String   @map("board_university") // GSEB / GUJARAT UNIVERSITY
  schoolCollege   String   @map("school_college") // Shree Vardayini High School, Rupal
  passingYear     Int      @map("passing_year") // 1990
  percentage      Decimal? @db.Decimal(5, 2) // 50.00
  grade           String? // A / B+ / Distinction
  specialization  String? // Commerce / Hindi / CS

  // Extra useful fields
  durationYears  Int? @map("duration_years")
  totalSemesters Int? @map("total_semesters") // actual sems for this degree

  // Consolidated certificate / degree scan
  certificateUrl String? @map("certificate_url")

  // Sem-wise marksheet uploads — max 8 sems
  sem1MarksheetUrl String? @map("sem1_marksheet_url")
  sem2MarksheetUrl String? @map("sem2_marksheet_url")
  sem3MarksheetUrl String? @map("sem3_marksheet_url")
  sem4MarksheetUrl String? @map("sem4_marksheet_url")
  sem5MarksheetUrl String? @map("sem5_marksheet_url")
  sem6MarksheetUrl String? @map("sem6_marksheet_url")
  sem7MarksheetUrl String? @map("sem7_marksheet_url")
  sem8MarksheetUrl String? @map("sem8_marksheet_url")

  // HR verification status
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedBy String?   @map("verified_by")
  verifiedAt DateTime? @map("verified_at")

  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, degreeType])
  @@map("academic_qualifications")
}

// =============================================================================
// PRIOR WORK EXPERIENCE (GraphQL / Hasura — employee_experience)
// =============================================================================

enum ExperienceType {
  TEACHING
  INDUSTRY
  RESEARCH
  ADMINISTRATIVE
  CONSULTANCY
  OTHER
}

model EmployeeExperience {
  id                    String   @id @default(uuid())
  employeeId            Int      @map("employee_id")
  type                  String // TEACHING (lookup)
  designation           String
  organizationName      String   @map("organization_name")
  fromDate              DateTime @map("from_date") @db.Date
  toDate                DateTime @map("to_date") @db.Date
  jobDescription        String?  @map("job_description")
  lastSalary            Decimal? @map("last_salary") @db.Decimal(12, 2)
  experienceLetterUrl   String?  @map("experience_letter_url")
  lastPaycheckUrl       String?  @map("last_paycheck_url")
  recommendationLetters Json     @default("[]") @map("recommendation_letters")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_experience")
}

// =============================================================================
// AUDIT LOG
// Append-only — covers all 8 sections above
// Sensitive fields logged as masked values e.g. aadhaar → "XXXX XXXX 2425"
// =============================================================================

model AuditLog {
  id           String   @id @default(uuid())
  tableName    String   @map("table_name") // e.g. "employee_personal_info"
  recordId     String   @map("record_id") // PK of the changed row
  employeeId   Int?     @map("employee_id") // which employee this data belongs to
  fieldName    String   @map("field_name") // which column changed
  oldValue     String?  @map("old_value") // previous value (masked if sensitive)
  newValue     String?  @map("new_value") // new value (masked if sensitive)
  changedBy    String   @map("changed_by") // userId who made the change
  changedAt    DateTime @default(now()) @map("changed_at")
  changeReason String?  @map("change_reason")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")

  @@index([tableName, recordId])
  @@index([employeeId])
  @@index([changedAt])
  @@map("audit_log")
}

model ChangeRequest {
  id          String        @id @default(uuid())
  employeeId  Int           @map("employee_id")
  module      String // "PERSONAL", "ADDRESS", "OTHER", "BANK"
  oldData     Json?         @map("old_data")
  newData     Json          @map("new_data")
  status      RequestStatus @default(PENDING)
  requestedAt DateTime      @default(now()) @map("requested_at")
  reviewedBy  String?       @map("reviewed_by")
  reviewedAt  DateTime?     @map("reviewed_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("change_requests")
}

// =============================================================================
// LEAVE MANAGEMENT
// =============================================================================

model LeaveType {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  applicableTo       LeaveApplicableTo @map("applicable_to")
  defaultDaysPerYear Float?            @map("default_days_per_year")
  isCarryForward     Boolean           @default(false) @map("is_carry_forward")
  allowHalfDay       Boolean           @default(true) @map("allow_half_day")
  skipPublicHolidays Boolean           @default(true) @map("skip_public_holidays")
  skipWeekends       Boolean           @default(true) @map("skip_weekends")
  requiresDocument   Boolean           @default(false) @map("requires_document")
  requiresReason     Boolean           @default(true) @map("requires_reason")
  isActive           Boolean           @default(true) @map("is_active")
  employeeCanApply   Boolean           @default(true) @map("employee_can_apply")
  /// When true, approved leave days of this type reduce salary (if column cutOnLeave is on).
  cutsSalary         Boolean           @default(false) @map("cuts_salary")
  creditSchedule     Json?             @map("credit_schedule")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  balances     LeaveBalance[]
  applications LeaveApplication[]

  @@map("leave_types")
}

model LeaveBalance {
  id             String    @id @default(uuid())
  employeeId     Int       @map("employee_id")
  leaveTypeId    String    @map("leave_type_id")
  year           Int
  totalCredited  Float     @default(0) @map("total_credited")
  carryForward   Float     @default(0) @map("carry_forward")
  used           Float     @default(0)
  pending        Float     @default(0)
  available      Float     @default(0)
  lastCreditedAt DateTime? @map("last_credited_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveApplication {
  id                     String                 @id @default(uuid())
  applicationNo          String                 @unique @map("application_no")
  employeeId             Int                    @map("employee_id")
  assignmentId           String?                @map("assignment_id")
  leaveTypeId            String                 @map("leave_type_id")
  fromDate               DateTime               @map("from_date")
  toDate                 DateTime               @map("to_date")
  isHalfDay              Boolean                @default(false) @map("is_half_day")
  halfDaySession         HalfDaySession?        @map("half_day_session")
  totalDays              Float                  @map("total_days")
  reason                 String
  documentUrl            String?                @map("document_url")
  status                 LeaveApplicationStatus @default(PENDING)
  appliedAt              DateTime               @default(now()) @map("applied_at")
  isAbsenceLinked        Boolean                @default(false) @map("is_absence_linked")
  absenceDate            DateTime?              @map("absence_date")
  absenceWindowExpiresAt DateTime?              @map("absence_window_expires_at")
  appliedBy              String                 @map("applied_by")
  isAppliedByAdmin       Boolean                @default(false) @map("is_applied_by_admin")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  employee       Employee            @relation(fields: [employeeId], references: [id])
  assignment     EmployeeAssignment? @relation(fields: [assignmentId], references: [id])
  leaveType      LeaveType           @relation(fields: [leaveTypeId], references: [id])
  approvalSteps  LeaveApprovalStep[]
  absenceRecords AbsenceRecord[]     @relation("AbsenceApplication")

  @@index([employeeId, fromDate])
  @@map("leave_applications")
}

model LeaveApprovalStep {
  id              String          @id @default(uuid())
  applicationId   String          @map("application_id")
  stepNumber      Int             @map("step_number")
  approverRole    ApproverRole    @map("approver_role")
  approverId      Int?            @map("approver_id") // legacy (employee id)
  approverUserId  String?         @map("approver_user_id")
  action          ApprovalAction?
  remarks         String?
  actionAt        DateTime?       @map("action_at")
  windowExpiresAt DateTime?       @map("window_expires_at")
  notifiedAt      DateTime?       @map("notified_at")
  isSuperseded    Boolean         @default(false) @map("is_superseded")
  createdAt       DateTime        @default(now()) @map("created_at")

  application LeaveApplication @relation(fields: [applicationId], references: [id])

  @@map("leave_approval_steps")
}

model AbsenceRecord {
  id                 String   @id @default(uuid())
  employeeId         Int      @map("employee_id")
  date               DateTime
  markedAt           DateTime @map("marked_at")
  windowExpiresAt    DateTime @map("window_expires_at")
  leaveApplicationId String?  @map("leave_application_id")
  assignmentId       String?  @map("assignment_id")
  convertedToLwp     Boolean  @default(false) @map("converted_to_lwp")
  bullmqJobId        String?  @map("bullmq_job_id")
  createdAt          DateTime @default(now()) @map("created_at")

  employee    Employee            @relation(fields: [employeeId], references: [id])
  application LeaveApplication?   @relation(fields: [leaveApplicationId], references: [id], name: "AbsenceApplication")
  assignment  EmployeeAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([employeeId, date])
  @@map("absence_records")
}

model PublicHoliday {
  id         String   @id @default(uuid())
  name       String
  date       DateTime
  year       Int
  isOptional Boolean  @default(false) @map("is_optional")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("public_holidays")
}

model LeaveSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String
  updatedBy   String   @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("leave_settings")
}

model LeaveAuditLog {
  id         String   @id @default(uuid())
  employeeId Int?     @map("employee_id")
  actorId    String   @map("actor_id")
  action     String
  context    String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("leave_audit_log")
}

model MonthlyLWPRecord {
  id         String   @id @default(uuid())
  employeeId Int      @map("employee_id")
  year       Int
  month      Int // 1-12
  days       Float    @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, month])
  @@map("monthly_lwp_records")
}

// =============================================================================
// ATTENDANCE (Biometric punches sync)
// =============================================================================

enum AttendanceSource {
  ESSL
  ETIMEOFFICE
  MOBILE_APP
}

model AttendanceLocation {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float
  radiusKm  Float
  isUnique  Boolean  @default(false)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  punches AttendancePunch[]

  @@map("attendance_locations")
}

model AttendancePunch {
  id          String           @id @default(uuid())
  employeeId  Int              @map("employee_id")
  punchAt     DateTime         @map("punch_at")
  source      AttendanceSource @default(ESSL)
  externalKey String           @unique @map("external_key") // idempotency key from MSSQL

  // Optional metadata (depends on MSSQL schema)
  terminalId String? @map("terminal_id")
  punchType  String? @map("punch_type")

  // Geofenced Biometric App Punch Data
  latitude   Float?
  longitude  Float?
  locationId String? @map("location_id")
  deviceInfo Json?   @map("device_info")
  reason     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  employee Employee            @relation(fields: [employeeId], references: [id])
  location AttendanceLocation? @relation(fields: [locationId], references: [id])

  @@index([employeeId, punchAt])
  @@map("attendance_punches")
}

model AttendanceSyncState {
  id           String           @id @default(uuid())
  source       AttendanceSource @unique
  lastSyncedAt DateTime?        @map("last_synced_at")
  cursor       String?          @map("cursor") // generic incremental cursor (e.g., last PK or timestamp)
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("attendance_sync_state")
}

model AttendancePolicy {
  /**
   * Single-row table (id = "default") holding punch timing policy.
   * Times are stored as "HH:MM" in Asia/Kolkata local time.
   */
  id                    String   @id @default("default")
  defaultPunchInTime    String   @default("10:00") @map("default_punch_in_time") // "HH:MM" IST
  defaultPunchOutTime   String   @default("19:00") @map("default_punch_out_time") // "HH:MM" IST
  punchInBufferMinutes  Int      @default(10) @map("punch_in_buffer_minutes")
  punchOutBufferMinutes Int      @default(10) @map("punch_out_buffer_minutes")
  updatedBy             String?  @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("attendance_policy")
}

/// Per-employee punch window overrides (falls back to global AttendancePolicy when useGlobalPolicy=true).
model EmployeeAttendanceSettings {
  employeeId            Int      @id @map("employee_id")
  useGlobalPolicy       Boolean  @default(true) @map("use_global_policy")
  punchInTime           String?  @map("punch_in_time")
  punchOutTime          String?  @map("punch_out_time")
  punchInBufferMinutes  Int?     @map("punch_in_buffer_minutes")
  punchOutBufferMinutes Int?     @map("punch_out_buffer_minutes")
  biometricToken        String?  @map("biometric_token")
  updatedBy             String?  @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_attendance_settings")
}

model DepartmentApprover {
  id            String   @id @default(uuid())
  department    String   @unique
  hodEmployeeId Int      @map("hod_employee_id")
  isActive      Boolean  @default(true) @map("is_active")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by")

  hod Employee @relation("DepartmentHod", fields: [hodEmployeeId], references: [id])

  @@map("department_approvers")
}

model InstituteApprover {
  id            String   @id @default(uuid())
  institute     String   @unique
  hoiEmployeeId Int      @map("hoi_employee_id")
  isActive      Boolean  @default(true) @map("is_active")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by")

  hoi Employee @relation("InstituteHoi", fields: [hoiEmployeeId], references: [id])

  @@map("institute_approvers")
}

model GlobalApprover {
  id                  String   @id @default(uuid())
  vcEmployeeId        Int?     @map("vc_employee_id")
  registrarEmployeeId Int?     @map("registrar_employee_id")
  isActive            Boolean  @default(true) @map("is_active")
  updatedAt           DateTime @updatedAt @map("updated_at")
  updatedBy           String?  @map("updated_by")

  vc        Employee? @relation("GlobalApproverVC", fields: [vcEmployeeId], references: [id])
  registrar Employee? @relation("GlobalApproverRegistrar", fields: [registrarEmployeeId], references: [id])

  @@map("global_approvers")
}

// =============================================================================
// AUTH & RBAC
// =============================================================================

// System modules — seeded, map to real backend code sections
model SystemModule {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]

  @@map("system_modules")
}

// Dynamic roles — admin creates/edits/deletes
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  permissions   RolePermission[]
  users         User[]
  designations  Designation[]
  positionSlots PositionSlot[]

  @@map("roles")
}

enum EmployeeViewScope {
  NONE
  SELF
  INSTITUTE
  UNIVERSITY
}

// Junction: Role → Module with granular action flags
model RolePermission {
  id        String @id @default(uuid())
  roleId    String @map("role_id")
  moduleKey String @map("module_key")

  canRead           Boolean           @default(false) @map("can_read")
  canWrite          Boolean           @default(false) @map("can_write")
  canApprove        Boolean           @default(false) @map("can_approve")
  canDelete         Boolean           @default(false) @map("can_delete")
  canExport         Boolean           @default(false) @map("can_export")
  /// Workforce directory visibility (PERSONAL_INFO module). Edit scope follows this.
  employeeViewScope EmployeeViewScope @default(NONE) @map("employee_view_scope")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  role   Role         @relation(fields: [roleId], references: [id])
  module SystemModule @relation(fields: [moduleKey], references: [key])

  @@unique([roleId, moduleKey])
  @@map("role_permissions")
}

// One user account per employee
model User {
  id                String    @id @default(uuid())
  employeeId        Int?      @unique @map("employee_id")
  username          String?   @unique @map("username")
  // Scope for position accounts (e.g., HOI-GIT). For employee-linked users this can remain null.
  subOrganization   String?   @map("sub_organization")
  roleId            String    @map("role_id")
  passwordHash      String    @map("password_hash")
  /// AES-encrypted plaintext for admin viewing (not used for auth)
  adminPasswordEnc  String?   @map("admin_password_enc")
  isFirstLogin      Boolean   @default(true) @map("is_first_login")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  /// 0 = 3 attempts, 1 = 2 attempts after 15m lock, 2 = 1 attempt after 1h lock, 3 = permanently blocked
  loginLockStage    Int       @default(0) @map("login_lock_stage")
  loginFailCount    Int       @default(0) @map("login_fail_count")
  loginLockedUntil  DateTime? @map("login_locked_until")
  loginBlockedAt    DateTime? @map("login_blocked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")

  role         Role          @relation(fields: [roleId], references: [id])
  employee     Employee?     @relation(fields: [employeeId], references: [id])
  positionSlot PositionSlot?

  firstApproverFor  EmployeeGeneralInfo[] @relation("FirstApproverUser")
  secondApproverFor EmployeeGeneralInfo[] @relation("SecondApproverUser")
  thirdApproverFor  EmployeeGeneralInfo[] @relation("ThirdApproverUser")

  assignedTasks      WorkTask[]      @relation("TaskAssigner")
  receivedTasks      WorkTask[]      @relation("TaskAssignee")
  extraApprovalTasks WorkTask[]      @relation("TaskExtraApprover")
  taskEvents         WorkTaskEvent[] @relation("TaskEventActor")
  orgTreesCreated    OrgTree[]

  createdChatChannels ChatChannel[]       @relation("ChatChannelCreator")
  chatChannelMembers  ChatChannelMember[]
  chatMessages        ChatMessage[]
  chatReactions       ChatReaction[]
  hostedMeetings      Meeting[]           @relation("MeetingHost")
  meetingParticipants MeetingParticipant[]
  meetingChatSent     MeetingChatMessage[] @relation("MeetingChatSender")

  @@map("users")
}

// =============================================================================
// ORG / EMPLOYEE TREE (admin-generated snapshots)
// =============================================================================

model OrgTree {
  id          String   @id @default(uuid())
  name        String
  description String?
  grouping    String   @default("DEPARTMENT_LEAD")
  isActive    Boolean  @default(false) @map("is_active")
  snapshot    Json
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User            @relation(fields: [createdById], references: [id])
  contacts  OrgTreeContact[]

  @@index([isActive])
  @@map("org_trees")
}

model OrgTreeContact {
  id           String  @id @default(uuid())
  treeId       String  @map("tree_id")
  moduleKey    String  @map("module_key")
  moduleName   String  @map("module_name")
  employeeId   Int?    @map("employee_id")
  note         String?
  sortOrder    Int     @default(0) @map("sort_order")

  tree     OrgTree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([treeId, moduleKey])
  @@map("org_tree_contacts")
}

// =============================================================================
// 9. SALARY INFORMATION
// PDF fields: Pay Commission, Pay Grade, Basic Salary, AGP, Gross Salary
// =============================================================================

model EmployeeSalaryInfo {
  id         String @id @default(uuid())
  employeeId Int    @unique @map("employee_id")

  payCommission   String?  @map("pay_commission")
  payCommissionId String?  @map("pay_commission_id")
  designationId   String?  @map("designation_id")
  payGrade        String?  @map("pay_grade")
  basicSalary     Decimal? @map("basic_salary") @db.Decimal(12, 2)
  agp             Decimal? @db.Decimal(12, 2)
  grossSalary     Decimal? @map("gross_salary") @db.Decimal(12, 2)
  columnOverrides Json?    @map("column_overrides")
  columnRules     Json?    @map("column_rules")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  employee         Employee       @relation(fields: [employeeId], references: [id])
  designationRef   Designation?   @relation(fields: [designationId], references: [id])
  payCommissionRef PayCommission? @relation(fields: [payCommissionId], references: [id])

  @@map("employee_salary_info")
}

// =============================================================================
// ORGANIZATIONS (top-level companies)
