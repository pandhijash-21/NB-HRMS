  carpetArea        Decimal? @map("carpet_area") @db.Decimal(14, 2)
  areaUnitCode      String?  @map("area_unit_code")
  statusCode        String   @default("AVAILABLE") @map("status_code")
  facingCode        String?  @map("facing_code")
  categoryCode      String?  @map("category_code")
  builtUpArea       Decimal? @map("built_up_area") @db.Decimal(14, 2)
  balconyArea       Decimal? @map("balcony_area") @db.Decimal(14, 2)
  terraceArea       Decimal? @map("terrace_area") @db.Decimal(14, 2)
  plotArea          Decimal? @map("plot_area") @db.Decimal(14, 2)
