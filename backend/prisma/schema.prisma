// =============================================================================
// INSTITUTES (sub-organizations)
// =============================================================================

model Institute {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String   @unique
  registrationNo       String?  @map("registration_no")
  establishmentYear    Int?     @map("establishment_year")
  contactPerson        String?  @map("contact_person")
  mobileNo             String?  @map("mobile_no")
  contactNo            String?  @map("contact_no")
  email                String?
  webAddress           String?  @map("web_address")
  panNo                String?  @map("pan_no")
  gstNo                String?  @map("gst_no")
  cinNo                String?  @map("cin_no")
  country              String?
  state                String?
  city                 String?
  address1             String?
  address2             String?
  pinCode              String?  @map("pin_code")
  tagLine              String?  @map("tag_line")
  hostingUrl           String?  @map("hosting_url")
  pageSize             String?  @map("page_size")
  dateFormat           String?  @map("date_format")
  timeZone             String?  @map("time_zone")
  socialPostUrl        String?  @map("social_post_url")
  bankName             String?  @map("bank_name")
  accountHolderName    String?  @map("account_holder_name")
  bankAccountNo        String?  @map("bank_account_no")
  ifscCode             String?  @map("ifsc_code")
  bankBranch           String?  @map("bank_branch")
  isChildCompany       Boolean  @default(false) @map("is_child_company")
  parentOrganizationId String?  @map("parent_organization_id")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  parentOrganization Organization?         @relation(fields: [parentOrganizationId], references: [id])
  generalInfoRecords EmployeeGeneralInfo[]
  positionSlots      PositionSlot[]
  assignments        EmployeeAssignment[]
  jobRequirements    JobRequirement[]
  erpProjects        ErpProject[]

  @@index([parentOrganizationId])
  @@map("institutes")
}

// =============================================================================
// DESIGNATION MASTER & POSITION SLOTS
// =============================================================================

model Designation {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  isAlias      Boolean  @default(false) @map("is_alias")
  linkedRoleId String?  @map("linked_role_id")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  linkedRole               Role?                     @relation(fields: [linkedRoleId], references: [id])
  generalInfoRecords       EmployeeGeneralInfo[]
  assignments              EmployeeAssignment[]
  salaryInfoRecords        EmployeeSalaryInfo[]
  positionSlots            PositionSlot[]
  salaryStructureTemplates SalaryStructureTemplate[]
  jobRequirements          JobRequirement[]

  @@map("designations")
}

model PositionSlot {
  id              String     @id @default(uuid())
  code            String     @unique
  name            String
  designationId   String     @map("designation_id")
  linkedRoleId    String     @map("linked_role_id")
  instituteId     String?    @map("institute_id")
  institute       Institute? @relation(fields: [instituteId], references: [id])
  subOrganization String?    @map("sub_organization")
  userId          String?    @unique @map("user_id")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  designation Designation          @relation(fields: [designationId], references: [id])
  linkedRole  Role                 @relation(fields: [linkedRoleId], references: [id])
  user        User?                @relation(fields: [userId], references: [id])
  assignments PositionAssignment[]

  @@map("position_slots")
}

model PositionAssignment {
  id               String    @id @default(uuid())
  positionSlotId   String    @map("position_slot_id")
  holderEmployeeId Int       @map("holder_employee_id")
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  assignedBy       String    @map("assigned_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  positionSlot   PositionSlot @relation(fields: [positionSlotId], references: [id], onDelete: Cascade)
  holderEmployee Employee     @relation(fields: [holderEmployeeId], references: [id])

  @@index([positionSlotId, effectiveFrom])
  @@map("position_assignments")
}

// =============================================================================
// SALARY MODULE
// =============================================================================

model PayCommission {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  ruleEditorEnabled Boolean  @default(true) @map("rule_editor_enabled")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  columnDefinitions        SalaryColumnDefinition[]
  salaryStructureTemplates SalaryStructureTemplate[]
  employeeSalaryInfos      EmployeeSalaryInfo[]

  @@map("pay_commissions")
}

model SalaryColumnDefinition {
  id                 String               @id @default(uuid())
  payCommissionId    String               @map("pay_commission_id")
  columnIdentifier   String               @map("column_identifier")
  displayName        String               @map("display_name")
  category           SalaryColumnCategory
  evaluationOrder    Int                  @map("evaluation_order")
  isRuleConfigurable Boolean              @default(true) @map("is_rule_configurable")
  /// Prorate this column when employee has unpaid leave days.
  cutOnLeave         Boolean              @default(false) @map("cut_on_leave")
  /// Prorate this column when employee has true absent days.
  cutOnAbsent        Boolean              @default(false) @map("cut_on_absent")

  payCommission PayCommission @relation(fields: [payCommissionId], references: [id], onDelete: Cascade)

  @@unique([payCommissionId, columnIdentifier, category])
  @@map("salary_column_definitions")
}

model SalaryStructureTemplate {
  id               String   @id @default(uuid())
  designationId    String   @map("designation_id")
  payCommissionId  String   @map("pay_commission_id")
  isActive         Boolean  @default(true) @map("is_active")
  /**
   * Per-column employee visibility: { "EARNING::basic": true }. Omitted keys default to visible.
   */
  columnVisibility Json?    @map("column_visibility")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  designation   Designation            @relation(fields: [designationId], references: [id])
  payCommission PayCommission          @relation(fields: [payCommissionId], references: [id])
  columnRules   SalaryColumnRule[]
  salaryRecords EmployeeSalaryRecord[]

  @@unique([designationId, payCommissionId])
  @@map("salary_structure_templates")
}

model SalaryColumnRule {
  id                         String               @id @default(uuid())
  templateId                 String               @map("template_id")
  columnIdentifier           String               @map("column_identifier")
  category                   SalaryColumnCategory
  ruleType                   RuleType             @map("rule_type")
  formulaPreview             String               @default("") @map("formula_preview")
  fixedDefaultValue          Decimal?             @map("fixed_default_value") @db.Decimal(14, 4)
  percentageValue            Decimal?             @map("percentage_value") @db.Decimal(10, 4)
  percentageReferenceColumns Json?                @map("percentage_reference_columns")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  template   SalaryStructureTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  conditions ConditionalRuleCondition[]

  @@unique([templateId, columnIdentifier, category])
  @@map("salary_column_rules")
}

model ConditionalRuleCondition {
  id                              String              @id @default(uuid())
  columnRuleId                    String              @map("column_rule_id")
  comparator                      ConditionComparator
  referenceColumnIdentifier       String              @map("reference_column_identifier")
  thresholdValue                  Decimal             @map("threshold_value") @db.Decimal(14, 4)
  resultType                      ConditionResultType @map("result_type")
