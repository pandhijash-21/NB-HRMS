// =============================================================================
// LETTER TEMPLATES + GENERATED LETTERS
// =============================================================================

model LetterTemplate {
  id          String  @id @default(uuid())
  key         String  @unique @map("template_key")
  name        String
  description String? @map("description")

  /**
   * HTML body with placeholders like {{fullName}}
   */
  templateHtml String  @map("template_html") @db.Text
  /**
   * Optional logo URL to be placed at top of the template
   */
  logoUrl      String? @map("logo_url")

  /**
   * JSON list of placeholder keys supported by this template
   */
  placeholders Json? @map("placeholders")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  documents EmployeeLetterDocument[]

  @@map("letter_templates")
}

model EmployeeLetterDocument {
  id         String @id @default(uuid())
  employeeId Int    @map("employee_id")
  templateId String @map("template_id")

  status      LetterDocumentStatus @default(DRAFT) @map("status") // DRAFT or FINAL
  /**
   * Rendered HTML (after placeholder substitution). Admin can edit draft content.
   */
  contentHtml String               @map("content_html") @db.Text

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template LetterTemplate @relation(fields: [templateId], references: [id])

  @@unique([employeeId, templateId, status])
  @@index([employeeId, templateId])
  @@map("employee_letter_documents")
}

enum LetterDocumentStatus {
  DRAFT
  FINAL
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ReimbursementClaim {
