// =============================================================================
// HRMS — Personal & Education Module ONLY
// Sections: Employee Info, General Info, Personal Info, Local Address,
//           Permanent Address, Other Info, Family Info, Academic Qualifications
// PostgreSQL + Prisma ORM
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum EmployeeCategory {
  TEACHING
  NON_TEACHING
  CONTRACT
  VISITING
}

enum AppointmentType {
  FULL_TIME_REGULAR
  FULL_TIME_CONTRACT
  PART_TIME
  VISITING
  DEPUTATION
}

enum FamilyRelation {
  FATHER
  MOTHER
  SPOUSE
  SON
  DAUGHTER
  BROTHER
  SISTER
  GUARDIAN
  OTHER
}

enum DegreeType {
  SSC          // Standard 10  — compulsory
  HSC          // Standard 12  — compulsory OR Diploma
  DIPLOMA      // Diploma       — compulsory OR HSC
  BACHELOR     // UG degree     — compulsory
  MASTER       // PG degree     — compulsory
  PHD          // Doctorate     — optional
}

enum AcademicMedium {
  GUJARATI
  HINDI
  ENGLISH
  MARATHI
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
  RETIRED
  TERMINATED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// 1. EMPLOYEE INFO
// Core identity row — every other section FKs here
// Auto-increment int ID matching college's existing numbering (29, 30, ...)
// =============================================================================

model Employee {
  id             Int            @id @default(autoincrement())   // Card ID: 29
  abbreviation   String?        @db.VarChar(10)                 // DSP
  userId         String         @unique @map("user_id")         // FK → auth user table
  status         EmployeeStatus @default(ACTIVE)

  // Photo & signature — Cloudinary URLs
  photoUrl       String?        @map("photo_url")
  signatureUrl   String?        @map("signature_url")

  lastUpdatedAt  DateTime       @updatedAt @map("last_updated_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  createdBy      String?        @map("created_by")

  // Relations — only the 8 sections you specified
  generalInfo      EmployeeGeneralInfo?
  personalInfo     EmployeePersonalInfo?
  addresses        EmployeeAddress[]
  otherInfo        EmployeeOtherInfo?
  familyMembers    FamilyMember[]
  academicQuals    AcademicQualification[]
  salaryInfo       EmployeeSalaryInfo?
  bankInfo         EmployeeBankInfo?
  user             User?
  changeRequests   ChangeRequest[]

  @@map("employees")
}

// =============================================================================
// 2. GENERAL INFORMATION
// PDF fields: Full Name, Original Joining Date, Joining Date, Increment Month,
//             Organization, Sub Organization, Department, Functional Department,
//             First Reporting, Second Reporting, Employee Category,
//             Designation, Shift, Appointment Type
// =============================================================================

model EmployeeGeneralInfo {
  id                   String           @id @default(uuid())
  employeeId           Int              @unique @map("employee_id")

  fullName             String           @map("full_name")               // DINESH SHANKARBHAI PATEL

  // Joining
  originalJoiningDate  DateTime         @map("original_joining_date")   // 11/06/2014
  joiningDate          DateTime         @map("joining_date")            // 11/06/2014
  incrementMonth       String?          @map("increment_month")         // July

  // Organization
  organization         String                                           // GANDHINAGAR UNIVERSITY
  subOrganization      String?          @map("sub_organization")        // GANDHINAGAR INSTITUTE OF TECHNOLOGY

  // Department
  department           String                                           // ADMIN DEPARTMENT
  functionalDepartment String?          @map("functional_department")   // ADMIN DEPARTMENT

  // Reporting hierarchy
  firstReporting       String?          @map("first_reporting")         // DHAVAL CHARANKUMAR SHAH
  secondReporting      String?          @map("second_reporting")        // KAMALESH VASHANTHKUMARI NAGARAJA

  // Employment classification
  employeeCategory     EmployeeCategory @map("employee_category")       // NON TEACHING
  designation          String                                           // O.S. ESTABLISHMENT
  shift                String?                                          // GENERAL
  appointmentType      AppointmentType? @map("appointment_type")        // Full Time-Regular
  employeeCode         String?          @unique @map("employee_code")   // GU1234

  updatedAt            DateTime         @updatedAt @map("updated_at")
  updatedBy            String?          @map("updated_by")

  employee             Employee         @relation(fields: [employeeId], references: [id])

  @@map("employee_general_info")
}

// =============================================================================
// 3. PERSONAL INFORMATION
// PDF fields: Birth Date, Birth Place, Home Town, Gender, Marital Status,
//             Nationality, Mother Tongue, Blood Group, Cast Category, Sub Caste,
//             Nominee Name, Nominee Relation
// Added (as requested): Aadhaar No (encrypted), PAN No (encrypted),
//                       Aadhaar card upload, PAN card upload
// Passport fields also in PDF's personal block — included here
// =============================================================================

model EmployeePersonalInfo {
  id               String        @id @default(uuid())
  employeeId       Int           @unique @map("employee_id")

  // PDF — Personal Information section
  birthDate        DateTime      @map("birth_date")                     // 27/05/1974
  birthPlace       String?       @map("birth_place")                    // RUPAL
  homeTown         String?       @map("home_town")                      // RUPAL
  gender           Gender
  maritalStatus    MaritalStatus @map("marital_status")                 // MARRIED
  nationality      String        @default("INDIAN")
  motherTongue     String?       @map("mother_tongue")                  // GUJARATI
  bloodGroup       BloodGroup?   @map("blood_group")                    // A+

  // Caste — Indian govt. requirement
  castCategory     String?       @map("cast_category")                  // OPEN
  subCaste         String?       @map("sub_caste")                      // KADVA PATEL

  // Nominee — kept in personal info as shown in PDF
  nomineeName      String?       @map("nominee_name")                   // KAILASH
  nomineeRelation  String?       @map("nominee_relation")               // WIFE

  // Identity numbers — ENCRYPTED at rest via Express/AES-256, never via Hasura
  aadhaarNo        String?       @map("aadhaar_no")                     // encrypted
  panNo            String?       @map("pan_no")                         // encrypted

  // Identity document scans — Cloudinary
  aadhaarCardUrl   String?       @map("aadhaar_card_url")
  panCardUrl       String?       @map("pan_card_url")

  // Passport — from PDF
  passportNo         String?     @map("passport_no")
  passportIssuePlace String?     @map("passport_issue_place")
  passportIssueDate  DateTime?   @map("passport_issue_date")
  passportExpiryDate DateTime?   @map("passport_expiry_date")

  updatedAt        DateTime      @updatedAt @map("updated_at")
  updatedBy        String?       @map("updated_by")

  employee         Employee      @relation(fields: [employeeId], references: [id])

  @@map("employee_personal_info")
}

// =============================================================================
// 4 & 5. LOCAL ADDRESS + PERMANENT ADDRESS
// PDF fields: Flat/Block No, Building/Society, Area, City, State, Country,
//             Zip/Postal Code, Phone No, Mobile No
// Local address also has: Intercom No, Personal Email, Institute Email, URL
// Single model with AddressType discriminator — avoids duplicating 12 columns
// @@unique([employeeId, addressType]) → exactly one LOCAL + one PERMANENT per employee
// =============================================================================

enum AddressType {
  LOCAL
  PERMANENT
}

model EmployeeAddress {
  id              String      @id @default(uuid())
  employeeId      Int         @map("employee_id")
  addressType     AddressType @map("address_type")

  // Both address types
  flatBlockNo     String?     @map("flat_block_no")                     // 407 / 279
  buildingSociety String?     @map("building_society")                  // DEVBHUMI PLAZA / TIMBAVAS
  area            String?                                               // OPP. SANKALP... / MOTO MADH
  city            String?                                               // BORISNA / RUPAL
  state           String?                                               // GUJARAT
  country         String?     @default("INDIA")
  zipPostalCode   String?     @map("zip_postal_code")                   // 382721
  phoneNo         String?     @map("phone_no")
  mobileNo        String?     @map("mobile_no")                         // 9904405950

  // Local address only — present in PDF's local address block
  intercomNo      String?     @map("intercom_no")                       // 203
  personalEmail   String?     @map("personal_email")                    // dspatel2011@gmail.com
  instituteEmail  String?     @map("institute_email")                   // dinesh.patel@gandhinagaruni.ac.in
  url             String?                                               // personal website

  updatedAt       DateTime    @updatedAt @map("updated_at")
  updatedBy       String?     @map("updated_by")

  employee        Employee    @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, addressType])
  @@map("employee_addresses")
}

// =============================================================================
// 6. OTHER INFORMATION
// PDF fields: Skill Set, Hobbies, Strength, Weakness,
//             Is Handicapped, Height (In Feet), Weight (In Kg)
// Note: Aadhaar, PAN, Passport appear in PDF's Other Info block but are
//       semantically identity data — moved to Personal Info above
// =============================================================================

model EmployeeOtherInfo {
  id              String    @id @default(uuid())
  employeeId      Int       @unique @map("employee_id")

  skillSet        String?   @map("skill_set")                           // HR
  hobbies         String?                                               // MUSIC
  strength        String?                                               // FAMILY
  weakness        String?                                               // FAMILY
  isHandicapped   Boolean   @default(false) @map("is_handicapped")      // No
  handicapDetails String?   @map("handicap_details")

  // Physical — from PDF
  heightInFeet    Decimal?  @map("height_in_feet") @db.Decimal(5,2)    // 157.00
  weightInKg      Decimal?  @map("weight_in_kg")   @db.Decimal(5,2)    // 79

  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")

  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_other_info")
}

// =============================================================================
// 7. FAMILY INFORMATION
// PDF fields: Relation, Name, City, Mobile No, Personal Email
// Added (as requested): Date of Birth, Aadhaar No (encrypted), Nominee flag
// =============================================================================

model FamilyMember {
  id             String         @id @default(uuid())
  employeeId     Int            @map("employee_id")

  // PDF fields
  relation       FamilyRelation
  name           String
  city           String?
  mobileNo       String?        @map("mobile_no")                       // 9998414432
  personalEmail  String?        @map("personal_email")

  // Extended (as requested)
  dateOfBirth    DateTime?      @map("date_of_birth")
  aadhaarNo      String?        @map("aadhaar_no")                      // encrypted AES-256
  isNominee      Boolean        @default(false) @map("is_nominee")

  isActive       Boolean        @default(true) @map("is_active")
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  updatedBy      String?        @map("updated_by")

  employee       Employee       @relation(fields: [employeeId], references: [id])

  @@map("family_members")
}

// =============================================================================
// 8. ACADEMIC QUALIFICATIONS
// PDF fields: Degree Type, Medium, Board/University, School/College,
//             Passing Year, Percentage/Grade, Specialization
// Added: Certificate upload, Sem-wise marksheets (sem1–sem8), Verification
//
// Compulsory rules enforced at APPLICATION layer (not DB — keeps it flexible):
//   SSC      → always compulsory
//   HSC      → compulsory unless DIPLOMA exists
//   DIPLOMA  → compulsory unless HSC exists
//   BACHELOR → always compulsory
//   MASTER   → always compulsory
//   PHD      → optional
//
// @@unique([employeeId, degreeType]) — one record per degree type per employee
// =============================================================================

model AcademicQualification {
  id               String          @id @default(uuid())
  employeeId       Int             @map("employee_id")

  // PDF fields
  degreeType       DegreeType      @map("degree_type")
  degreeName       String?         @map("degree_name")                  // B.E. Computer Engineering
  medium           AcademicMedium?
  boardUniversity  String          @map("board_university")             // GSEB / GUJARAT UNIVERSITY
  schoolCollege    String          @map("school_college")               // Shree Vardayini High School, Rupal
  passingYear      Int             @map("passing_year")                 // 1990
  percentage       Decimal?        @db.Decimal(5,2)                     // 50.00
  grade            String?                                              // A / B+ / Distinction
  specialization   String?                                              // Commerce / Hindi / CS

  // Extra useful fields
  durationYears    Int?            @map("duration_years")
  totalSemesters   Int?            @map("total_semesters")              // actual sems for this degree

  // Consolidated certificate / degree scan
  certificateUrl   String?         @map("certificate_url")

  // Sem-wise marksheet uploads — max 8 sems
  sem1MarksheetUrl String?         @map("sem1_marksheet_url")
  sem2MarksheetUrl String?         @map("sem2_marksheet_url")
  sem3MarksheetUrl String?         @map("sem3_marksheet_url")
  sem4MarksheetUrl String?         @map("sem4_marksheet_url")
  sem5MarksheetUrl String?         @map("sem5_marksheet_url")
  sem6MarksheetUrl String?         @map("sem6_marksheet_url")
  sem7MarksheetUrl String?         @map("sem7_marksheet_url")
  sem8MarksheetUrl String?         @map("sem8_marksheet_url")

  // HR verification status
  isVerified       Boolean         @default(false) @map("is_verified")
  verifiedBy       String?         @map("verified_by")
  verifiedAt       DateTime?       @map("verified_at")

  displayOrder     Int             @default(0) @map("display_order")
  isActive         Boolean         @default(true) @map("is_active")
  deletedAt        DateTime?       @map("deleted_at")

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  updatedBy        String?         @map("updated_by")

  employee         Employee        @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, degreeType])
  @@map("academic_qualifications")
}

// =============================================================================
// AUDIT LOG
// Append-only — covers all 8 sections above
// Sensitive fields logged as masked values e.g. aadhaar → "XXXX XXXX 2425"
// =============================================================================

model AuditLog {
  id           String   @id @default(uuid())
  tableName    String   @map("table_name")        // e.g. "employee_personal_info"
  recordId     String   @map("record_id")         // PK of the changed row
  employeeId   Int?     @map("employee_id")       // which employee this data belongs to
  fieldName    String   @map("field_name")        // which column changed
  oldValue     String?  @map("old_value")         // previous value (masked if sensitive)
  newValue     String?  @map("new_value")         // new value (masked if sensitive)
  changedBy    String   @map("changed_by")        // userId who made the change
  changedAt    DateTime @default(now()) @map("changed_at")
  changeReason String?  @map("change_reason")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")

  @@index([tableName, recordId])
  @@index([employeeId])
  @@index([changedAt])
  @@map("audit_log")
}

model ChangeRequest {
  id          String   @id @default(uuid())
  employeeId  Int      @map("employee_id")
  module      String   // "PERSONAL", "ADDRESS", "OTHER", "BANK"
  oldData     Json?    @map("old_data")
  newData     Json     @map("new_data")
  status      RequestStatus @default(PENDING)
  requestedAt DateTime @default(now()) @map("requested_at")
  reviewedBy  String?  @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@map("change_requests")
}

// =============================================================================
// AUTH & RBAC
// =============================================================================

// System modules — seeded, map to real backend code sections
model SystemModule {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  permissions RolePermission[]

  @@map("system_modules")
}

// Dynamic roles — admin creates/edits/deletes
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

// Junction: Role → Module with granular action flags
model RolePermission {
  id        String @id @default(uuid())
  roleId    String @map("role_id")
  moduleKey String @map("module_key")

  canRead    Boolean @default(false) @map("can_read")
  canWrite   Boolean @default(false) @map("can_write")
  canApprove Boolean @default(false) @map("can_approve")
  canDelete  Boolean @default(false) @map("can_delete")
  canExport  Boolean @default(false) @map("can_export")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  role   Role         @relation(fields: [roleId], references: [id])
  module SystemModule @relation(fields: [moduleKey], references: [key])

  @@unique([roleId, moduleKey])
  @@map("role_permissions")
}

// One user account per employee
model User {
  id                String    @id @default(uuid())
  employeeId        Int       @unique @map("employee_id")
  roleId            String    @map("role_id")
  passwordHash      String    @map("password_hash")
  isFirstLogin      Boolean   @default(true) @map("is_first_login")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")

  role     Role     @relation(fields: [roleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("users")
}

// =============================================================================
// 9. SALARY INFORMATION
// PDF fields: Pay Commission, Pay Grade, Basic Salary, AGP, Gross Salary
// =============================================================================

model EmployeeSalaryInfo {
  id              String    @id @default(uuid())
  employeeId      Int       @unique @map("employee_id")

  payCommission   String?   @map("pay_commission")
  payGrade        String?   @map("pay_grade")
  basicSalary     Decimal?  @map("basic_salary") @db.Decimal(12, 2)
  agp             Decimal?  @db.Decimal(12, 2)
  grossSalary     Decimal?  @map("gross_salary") @db.Decimal(12, 2)

  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")

  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_salary_info")
}

// =============================================================================
// 10. BANK INFORMATION
// PDF fields: Bank Name, Bank Account No, Bank Branch Code, IFSC Code
// =============================================================================

model EmployeeBankInfo {
  id              String    @id @default(uuid())
  employeeId      Int       @unique @map("employee_id")

  bankName        String?   @map("bank_name")
  bankAccountNo   String?   @map("bank_account_no")
  bankBranchCode  String?   @map("bank_branch_code")
  ifscCode        String?   @map("ifsc_code")

  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by")

  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@map("employee_bank_info")
}


