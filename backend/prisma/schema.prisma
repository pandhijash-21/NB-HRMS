model LocationHistory {
  id         String   @id @default(uuid())
  employeeId Int      @map("employee_id")
  latitude   Float
  longitude  Float
  heading    Float?
  timestamp  DateTime @default(now())
  tripId     String?  @map("trip_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trip     Trip?    @relation(fields: [tripId], references: [id])

  @@index([employeeId, timestamp])
  @@map("location_history")
}

model Trip {
  id              String    @id @default(uuid())
  employeeId      Int       @map("employee_id")
  startLocationId String?   @map("start_location_id")
  endLocationId   String?   @map("end_location_id")
  startTime       DateTime  @default(now()) @map("start_time")
  endTime         DateTime? @map("end_time")
  distanceKm      Float     @default(0) @map("distance_km")

  // Computed Tracking Hub fields
  routeGeometry         String? @map("route_geometry") @db.Text // OSRM snapped polyline or GeoJSON
  activeTime            Int     @default(0) @map("active_time") // seconds
  idleTime              Int     @default(0) @map("idle_time") // seconds
  trackingUptimePercent Float   @default(100.0) @map("tracking_uptime_percent")
  gapCount              Int     @default(0) @map("gap_count")
  totalGapDuration      Int     @default(0) @map("total_gap_duration") // seconds

  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationHistories LocationHistory[]
  trackingEvents    TrackingEvent[]

  @@index([employeeId, startTime])
  @@map("trips")
}

enum TrackingEventSource {
  EXPLICIT_EVENT
  INFERRED_FROM_HEARTBEAT_GAP
}

enum TrackingEventConfidence {
  HIGH
  MEDIUM
  LOW
}

enum TrackingEventType {
  LOCATION_PERMISSION_REVOKED
  LOCATION_SERVICE_DISABLED
  BACKGROUND_SERVICE_KILLED
  GPS_SIGNAL_LOST
  NETWORK_UNAVAILABLE
  APP_FORCE_CLOSED
  DEVICE_RESTARTED
  BATTERY_DIED
  MANUAL_PAUSE
}

model TrackingEvent {
  id            String                  @id @default(uuid())
  employeeId    Int                     @map("employee_id")
  tripId        String?                 @map("trip_id")
  eventType     TrackingEventType       @map("event_type")
  timestamp     DateTime                @default(now())
  endTime       DateTime?               @map("end_time") // For inferred gaps, when it ended
  latitude      Float?
  longitude     Float?
  accuracy      Float?
  batteryLevel  Float?                  @map("battery_level")
  networkStatus String?                 @map("network_status")
  source        TrackingEventSource
  confidence    TrackingEventConfidence
  gapReasonId   String?                 @map("gap_reason_id") // Extra context from OS on resume

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trip     Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([employeeId, timestamp])
  @@index([tripId, timestamp])
  @@map("tracking_events")
}

// =============================================================================
// WORK TASKS (reporting-manager assigned work)
// =============================================================================

enum WorkTaskStatus {
  ASSIGNED
  ONGOING
  COMPLETED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum WorkTaskExtraApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkTaskEventType {
  CREATED
  STATUS_CHANGED
  EXTRA_APPROVAL_REQUESTED
  EXTRA_APPROVAL_DECIDED
  REVIEWED
  SUBTASK_UPDATED
}

model WorkTask {
  id          String         @id @default(uuid())
  title       String
  description String?        @db.Text
  status      WorkTaskStatus @default(ASSIGNED)

  assignerUserId     String @map("assigner_user_id")
  assigneeUserId     String @map("assignee_user_id")
  assigneeEmployeeId Int    @map("assignee_employee_id")

  deadline    DateTime
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  reviewedAt  DateTime? @map("reviewed_at")

  attachmentUrl  String? @map("attachment_url")
  attachmentName String? @map("attachment_name")
  attachmentMime String? @map("attachment_mime")

  extraApproverUserId    String?                      @map("extra_approver_user_id")
  extraApprovalStatus    WorkTaskExtraApprovalStatus? @map("extra_approval_status")
  extraApprovalRemarks   String?                      @map("extra_approval_remarks") @db.Text
  extraApprovalDecidedAt DateTime?                    @map("extra_approval_decided_at")

  reviewRemarks String? @map("review_remarks") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assigner      User            @relation("TaskAssigner", fields: [assignerUserId], references: [id])
  assignee      User            @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  extraApprover User?           @relation("TaskExtraApprover", fields: [extraApproverUserId], references: [id])
  employee      Employee        @relation(fields: [assigneeEmployeeId], references: [id], onDelete: Cascade)
  events        WorkTaskEvent[]
  subtasks      WorkTaskSubtask[]

  @@index([assignerUserId, status])
  @@index([assigneeUserId, status])
  @@index([extraApproverUserId, extraApprovalStatus])
  @@index([deadline])
  @@map("work_tasks")
}

model WorkTaskEvent {
  id          String            @id @default(uuid())
  taskId      String            @map("task_id")
  actorUserId String            @map("actor_user_id")
  type        WorkTaskEventType
  fromStatus  WorkTaskStatus?   @map("from_status")
  toStatus    WorkTaskStatus?   @map("to_status")
  remarks     String?           @db.Text
  newDeadline DateTime?         @map("new_deadline")
  createdAt   DateTime          @default(now()) @map("created_at")

  task  WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User     @relation("TaskEventActor", fields: [actorUserId], references: [id])

  @@index([taskId, createdAt])
  @@map("work_task_events")
}

model WorkTaskSubtask {
  id        String  @id @default(uuid())
  taskId    String  @map("task_id")
  title     String
  sortOrder Int     @default(0) @map("sort_order")
  isDone    Boolean @default(false) @map("is_done")

  completedAt DateTime? @map("completed_at")

  attachmentUrl  String? @map("attachment_url")
  attachmentName String? @map("attachment_name")
  attachmentMime String? @map("attachment_mime")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("work_task_subtasks")
}

